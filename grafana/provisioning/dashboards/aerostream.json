{
  "title": "AeroStream",
  "uid": "aerostream",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "tags": ["aerostream"],
  "annotations": { "list": [] },
  "links": [],
  "templating": { "list": [] },
  "timepicker": {},
  "panels": [
    {
      "id": 1,
      "title": "Telemetry ingest rate (per drone)",
      "description": "Packets accepted into the ingestion channel per second, broken out by drone_id.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(aerostream_telemetry_received_total[1m])) by (drone_id) > 0",
          "legendFormat": "{{drone_id}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Ingest throughput & channel depth",
      "description": "Total ingest rate (all drones combined, left axis) and current channel backlog depth (right axis). Rate is visible under normal load. Depth spikes only when the processor cannot drain the channel fast enough — a non-zero depth line is the backpressure alarm.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(aerostream_telemetry_received_total[30s]))",
          "legendFormat": "ingest rate (req/s)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "aerostream_ingestion_channel_depth",
          "legendFormat": "channel depth",
          "refId": "B"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "channel depth" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.fillOpacity", "value": 30 },
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }
            ]
          }
        ]
      }
    },
    {
      "id": 3,
      "title": "Persistence batch latency — p50 / p95 by outcome",
      "description": "Histogram quantiles split by outcome label. Success and failure should never overlap: connection-refused failures fail in <30ms; successful persists cluster around 20-100ms. A p95 spike on outcome=success means slow DB; outcome=failure appearing at all means connectivity loss.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(aerostream_persistence_batch_duration_seconds_bucket[5m])) by (le, outcome))",
          "legendFormat": "p50 {{outcome}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(aerostream_persistence_batch_duration_seconds_bucket[5m])) by (le, outcome))",
          "legendFormat": "p95 {{outcome}}",
          "refId": "B"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 5, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [{ "id": "custom.lineStyle", "value": { "dash": [8, 4], "fill": "dash" } }]
          }
        ]
      }
    },
    {
      "id": 4,
      "title": "RTL triggers by reason",
      "description": "Rate of RTL commands triggered, split by reason: geofence breach, battery_critical (≤18V backend enforcement), or operator_manual (dashboard command).",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(aerostream_rtl_triggered_total[1m])) by (reason)",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Geofence breaches",
      "description": "Rate of geofence breach events (drones exiting the deployed boundary polygon). Each breach also fires an RTL command and a telemetry.alert.geofence RabbitMQ event.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(aerostream_geofence_breach_total[1m]))",
          "legendFormat": "breach rate",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 30, "showPoints": "never" }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "RabbitMQ publish vs consume rate",
      "description": "Publish rate by routing_key (what the API sends); consume rate by queue and result. nack_dead_letter appearing means malformed messages hitting the DLQ — a live poison-message signal.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(aerostream_rabbitmq_published_total[1m])) by (routing_key)",
          "legendFormat": "pub: {{routing_key}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(aerostream_rabbitmq_consumed_total[1m])) by (queue, result)",
          "legendFormat": "con: {{queue}} [{{result}}]",
          "refId": "B"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2, "fillOpacity": 5, "showPoints": "never" }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "HTTP 429 rate by endpoint",
      "description": "Rate of 429 Too Many Requests responses by endpoint. Visible because UseHttpMetrics() runs before UseRateLimiter() in the middleware pipeline. A spike here means a misbehaving or spoofed drone is hammering the per-drone rate limit.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_request_duration_seconds_count{code=\"429\"}[1m])) by (endpoint)",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 20, "showPoints": "never" }
        },
        "overrides": []
      }
    }
  ]
}
